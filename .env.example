# Copy to .env and edit. Every value here has a working default, so the service
# and the test suite run with none of them set.

# ---------------------------------------------------------------- decider
# baseline: take the top retrieved candidate. No API key, no cost, and the
#   number every other approach has to beat. This is the default.
# claude:   ask a model to pick from the shortlist and ground the choice in
#   quoted spans. Needs ANTHROPIC_API_KEY.
PCAGENT_DECIDER=baseline

# Only read when PCAGENT_DECIDER=claude.
# ANTHROPIC_API_KEY=sk-ant-...
PCAGENT_MODEL=claude-opus-5-5
PCAGENT_LLM_TIMEOUT=20

# ------------------------------------------------------------------ paths
# PCAGENT_DATA_DIR=./data
# PCAGENT_DB=./pcagent.db

# ----------------------------------------------------------------- triage
# Classifications at or below this confidence go to a human. Pick it from the
# routing table in evals/report-*.md, not by taste.
PCAGENT_REVIEW_THRESHOLD=0.65

# Ceiling on in flight classifications in the batch agent.
PCAGENT_MAX_CONCURRENCY=4

# ------------------------------------------------------------------- auth
# A stand in for an identity provider. Unset, the service falls back to the
# development tokens in config.py and logs a warning. Format is a JSON object
# of token to subject and scopes.
# PCAGENT_TOKENS={"tok-a":{"subject":"svc-reader","scopes":["codes:read","classify:run","reviews:read"]},"tok-b":{"subject":"ana","scopes":["codes:read","classify:run","reviews:read","reviews:write"]}}

# The MCP server runs as one user over stdio, so its principal is fixed at
# startup from this token rather than supplied per call.
# PCAGENT_TOKEN=dev-reviewer-token

# ------------------------------------------------------------------- perf
# Pinned in the eval runner so two runs on the same machine are comparable.
# Left unset, ONNX picks a thread count based on current load.
# PCAGENT_ONNX_THREADS=4
